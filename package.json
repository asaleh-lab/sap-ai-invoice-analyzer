{
  "name": "sap-ai-invoice-analyzer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy": "cds deploy --to sqlite:db.sqlite",
    "test": "node --experimental-strip-types --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cap-js/sqlite": "3.1.2",
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.6.0",
    "@langchain/openai": "1.8.0",
    "@sap/cds": "10.2.2"
  },
  "devDependencies": {
    "@sap/cds-dk": "10.2.0",
    "@types/node": "22.19.15",
    "typescript": "7.0.2"
  },
  "cds": {
    "i18n": {
      "default_language": "en",
      "languages": "en,de"
    },
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    }
  }
}
