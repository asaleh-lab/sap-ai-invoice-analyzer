{
  "_version": "1.65.0",
  "sap.app": {
    "id": "workbench",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": ["en", "de"],
      "fallbackLocale": "en"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "0.1.0" },
    "dataSources": {
      "main": {
        "uri": "/workbench/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.144.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.fe.templates": {}
      }
    },
    "resources": {
      "css": [{ "uri": "css/dashboard.css" }]
    },
    "rootView": {
      "viewName": "sap.fe.core.rootView.Fcl",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "workbench.i18n.i18n",
          "supportedLocales": ["en", "de"],
          "fallbackLocale": "en"
        }
      },
      "": {
        "dataSource": "main",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsMidExpanded",
          "defaultThreeColumnLayoutType": "ThreeColumnsMidExpanded"
        }
      },
      "routes": [
        { "pattern": ":?query:", "name": "InvestigationsList", "target": "InvestigationsList" },
        {
          "pattern": "Investigations({key}):?query:",
          "name": "InvestigationsObjectPage",
          "target": ["InvestigationsList", "InvestigationsObjectPage"]
        }
      ],
      "targets": {
        "InvestigationsList": {
          "type": "Component",
          "id": "InvestigationsList",
          "name": "sap.fe.templates.ListReport",
          "controlAggregation": "beginColumnPages",
          "contextPattern": "",
          "options": {
            "settings": {
              "contextPath": "/Investigations",
              "initialLoad": true,
              "variantManagement": "None",
              "navigation": {
                "Investigations": {
                  "detail": { "route": "InvestigationsObjectPage" }
                }
              },
              "views": {
                "paths": [
                  {
                    "key": "pending",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant"
                  },
                  {
                    "key": "history",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#History"
                  }
                ]
              },
              "content": {
                "table": {
                  "noData": {
                    "text": "{i18n>noCases}"
                  }
                }
              }
            }
          }
        },
        "InvestigationsObjectPage": {
          "type": "Component",
          "id": "InvestigationsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "controlAggregation": "midColumnPages",
          "options": {
            "settings": {
              "contextPath": "/Investigations",
              "content": {
                "header": {
                  "actions": {
                    "retryInvestigation": {
                      "press": "workbench.ext.ObjectPage.retryInvestigation",
                      "text": "{i18n>retry}",
                      "icon": "sap-icon://refresh",
                      "visible": "{= %{status} === 'investigation_failed' }"
                    },
                    "askAdvisor": {
                      "press": "workbench.ext.ObjectPage.askAdvisor",
                      "text": "{i18n>askAdvisor}",
                      "icon": "sap-icon://discussion-2"
                    },
                    "releasePaymentBlock": {
                      "press": "workbench.ext.ObjectPage.releasePaymentBlock",
                      "text": "{i18n>releasePaymentBlock}",
                      "icon": "sap-icon://unlocked"
                    },
                    "postSubsequentCredit": {
                      "press": "workbench.ext.ObjectPage.postSubsequentCredit",
                      "text": "{i18n>postSubsequentCredit}",
                      "icon": "sap-icon://expense-report"
                    },
                    "prepareSupplierContact": {
                      "press": "workbench.ext.ObjectPage.prepareSupplierContact",
                      "text": "{i18n>callAndSendEmail}",
                      "icon": "sap-icon://email"
                    },
                    "dismissInvestigation": {
                      "press": "workbench.ext.ObjectPage.dismissInvestigation",
                      "text": "{i18n>dismiss}",
                      "icon": "sap-icon://decline"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "workbench.ext.ListReport"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "workbench.ext.ObjectPage"
          },
          "sap.fe.core.rootView.Fcl": {
            "controllerName": "workbench.ext.Fcl"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
